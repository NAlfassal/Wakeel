# ── Twilio ──────────────────────────────────────────────────
# من: https://console.twilio.com  ← الصفحة الرئيسية
TWILIO_ACCOUNT_SID=ACxxxxxx
TWILIO_AUTH_TOKEN=c0bxxxxx

# رقم الـ Sandbox (لا تغيره — هذا الرقم الافتراضي لـ Twilio Sandbox)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── OpenRouter (Gemini Free) ─────────────────────────────────
# من: https://openrouter.ai  ← API Keys ← Create Key
OPENROUTER_API_KEY=sk-xxxx
# اسم النموذج المجاني على OpenRouter
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001

# ── إعدادات المتجر (للديمو) ──────────────────────────────────
STORE_NAME=متجر نور
STORE_NAME_EN=Noor Store

# ── إعدادات الخادم ───────────────────────────────────────────
PORT=8000
